# Dependencies
node_modules/
cdk/node_modules/

# CDK build output
cdk/cdk.out/
cdk/cdk.out*/
cdk/*.js
cdk/*.d.ts

# CDK context cache — per-account VPC/AZ lookups. Must NOT be committed: it
# pins account IDs + VPC/subnet IDs and breaks Vpc.fromLookup for other users.
cdk/cdk.context.json

# Data (large files tracked via Git LFS, not committed directly)
data/**
!data/*.zip

# training/data: keep ONLY the LFS-tracked source zip; ignore generated
# artifacts (unzipped episodes, converted LeRobot datasets, render videos).
training/data/**
!training/data/
!training/data/*.zip

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets / tokens
.env
*.env.local

# Docker build cache
containers/**/build/

# OSMO values with credentials
osmo_values.yaml
