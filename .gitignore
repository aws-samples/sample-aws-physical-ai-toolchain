# Dependencies
node_modules/
cdk/node_modules/

# CDK build output
cdk/cdk.out/
cdk/cdk.out*/
cdk/*.js
cdk/*.d.ts

# CDK context cache — per-account VPC/AZ lookups. Must NOT be committed: it
# pins account IDs + VPC/subnet IDs and breaks Vpc.fromLookup for other users.
cdk/cdk.context.json

# Data (large files tracked via Git LFS, not committed directly)
data/**
!data/*.zip

# Extracted / generated training data under training/data/. The source-of-truth
# zip (ur3_episodes_001_027.zip) is tracked via Git LFS; these are unzipped or
# derived from it and must not be committed (episodes/ is ~1.8 GB).
training/data/episodes/
training/data/ur3_lerobot_dataset/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/
.eggs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets / tokens
.env
*.env.local

# Terraform
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform.lock.hcl
# S8: isaac-lab-arena-on-aws COMMITS its lock file -- that is what makes a fresh
# clone select the same provider build, and ignoring it defeated the version pinning
# in its versions.tf. Scoped so other components keep the repo-wide default.
!isaac-lab-arena-on-aws/infra/.terraform.lock.hcl

# Docker build cache
containers/**/build/

# OSMO values with credentials
osmo_values.yaml

# Authored scripts, plans, agent instructions and reports remain visible to Git.
# Review them before staging; temporary work is not automatically publishable.

notebooks/lab1/.env
notebooks/lab4/.env


# Notebook checkpoints (can contain secrets from cell execution)
.ipynb_checkpoints/

# SageMaker local credentials, caches and execution evidence (runner is in scripts/local/).
local-dev/
