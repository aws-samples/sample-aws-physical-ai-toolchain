# Dependencies
node_modules/
cdk/node_modules/

# CDK build output
cdk/cdk.out/
cdk/cdk.out*/
cdk/*.js
cdk/*.d.ts

# CDK context cache — per-account VPC/AZ lookups. Must NOT be committed: it
# pins account IDs + VPC/subnet IDs and breaks Vpc.fromLookup for other users.
cdk/cdk.context.json

# Data (large files tracked via Git LFS, not committed directly)
data/**
!data/*.zip

# Extracted / generated training data under training/data/. The source-of-truth
# zip (ur3_episodes_001_027.zip) is tracked via Git LFS; these are unzipped or
# derived from it and must not be committed (episodes/ is ~1.8 GB).
training/data/episodes/
training/data/ur3_lerobot_dataset/

# Binary design docs / working artifacts (not source)
*.docx

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/
.eggs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets / tokens
.env
*.env.local

# Docker build cache
containers/**/build/

# OSMO values with credentials
osmo_values.yaml
